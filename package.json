{
  "name": "pcep101",
  "private": true,
  "version": "0.0.0",
  "description": "PCEP101 \u2014 Python Certification Made Simple. Self-study web app for the PCEP exam.",
  "type": "module",
  "scripts": {
    "setup:pyodide": "node scripts/setup-pyodide.mjs",
    "predev": "npm run setup:pyodide",
    "dev": "vite",
    "prebuild": "npm run setup:pyodide",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "pretest": "npm run setup:pyodide",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b",
    "lint": "oxlint",
    "content:status": "node scripts/content-status.ts",
    "content:quality": "node scripts/content-quality.ts"
  },
  "dependencies": {
    "pyodide": "314.0.8",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@mdx-js/rollup": "^3.1.1",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.5",
    "@testing-library/jest-dom": "^8.0.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.13",
    "@types/mdx": "^2.0.14",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "jsdom": "^31.0.1",
    "oxlint": "^1.94.0",
    "remark-gfm": "^4.0.1",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  }
}
